{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "App",
            "request": "launch",
            "mainClass": "App",
            "osx": {
                "vmArgs": "-XstartOnFirstThread"
            }
        }
    ]
}
// flag for mac to run on the first thread since crashes happened due to it running on second thread, its talking to the JVM